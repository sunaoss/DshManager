# 统一换行符，避免不同平台 clone 出来的文件反复显示为已修改
* text=auto eol=lf

# Windows 原生文本：保持 CRLF
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.iss   text eol=crlf
*.csproj text eol=crlf
*.sln   text eol=crlf
*.wxs   text eol=crlf

# 二进制：不要做任何换行转换，也不要在 diff 里当文本处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pdb   binary

# 安装包是构建产物，让 GitHub 不要把它算进语言统计
installer/output/*.exe  linguist-generated=true -diff
