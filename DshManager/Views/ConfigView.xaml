<UserControl x:Class="DshManager.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DshManager.Models">
    <UserControl.Resources>
        <!-- 布尔 → 可见性（NewSessionOnly 角标、"已改"角标用） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 下拉框内联样式（项目未提供 ComboBox 共享样式，这里就地定义，不改动 Styles/*） -->
        <Style x:Key="InlineComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#330A1620"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>

        <!-- ============ 按 ParamKind 区分的编辑控件模板 ============ -->

        <!-- 文本 -->
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MoeTextBoxStyle}"
                     HorizontalAlignment="Left" MaxWidth="420" MinWidth="240"/>
        </DataTemplate>

        <!-- 数字 -->
        <DataTemplate x:Key="NumberEditor">
            <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MoeTextBoxStyle}"
                     HorizontalAlignment="Left" MaxWidth="180" MinWidth="140"/>
        </DataTemplate>

        <!-- 开关 -->
        <DataTemplate x:Key="BoolEditor">
            <ToggleButton IsChecked="{Binding BoolValue}"
                          Style="{DynamicResource MoeToggleSwitchStyle}"
                          HorizontalAlignment="Left"/>
        </DataTemplate>

        <!-- 枚举下拉 -->
        <DataTemplate x:Key="EnumEditor">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding StringValue}"
                      Style="{StaticResource InlineComboStyle}"/>
        </DataTemplate>

        <!-- 复杂结构：只读多行展示，改它请直接编辑 settings.yaml -->
        <DataTemplate x:Key="ComplexEditor">
            <TextBox Text="{Binding StringValue, Mode=OneWay}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="60" MaxHeight="150" MaxWidth="560" HorizontalAlignment="Left">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MoeTextBoxStyle}">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,14">
            <TextBlock Text="⚙️" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock Text="配置" Style="{DynamicResource SectionTitleStyle}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="— DSH 官方设置 · settings.yaml（热加载，保存即生效）"
                       Style="{DynamicResource MutedTextStyle}"
                       Margin="12,4,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 可滚动的分组表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 每个分组一张卡片 -->
                        <Border Style="{DynamicResource MoeCardStyle}" Padding="22,16,22,18" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- 分组标题 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🌊" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource WhaleBlueBrush}"
                                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 该组下的参数行 -->
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 左：中文名 + 角标 + 说明 + 键路径/默认值 -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Meta.Title}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- 「只对之后新建的会话生效」角标 -->
                                                        <TextBlock Text="●" FontSize="12" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource PinkAccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="只对之后新建的会话生效"
                                                                   Visibility="{Binding Meta.NewSessionOnly,
                                                                                Converter={StaticResource BoolToVis}}"/>
                                                        <!-- 「已改（还没保存）」角标 -->
                                                        <TextBlock Text="已改" FontSize="10" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource WhaleBlueBrush}"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="这一项已修改，点「保存」才会写入文件"
                                                                   Visibility="{Binding IsChanged,
                                                                                Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Meta.Help}"
                                                               Style="{DynamicResource MutedTextStyle}"
                                                               Margin="0,4,0,0" TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding Meta.Path}" FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,4,0,0" Opacity="0.8"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Opacity="0.8">
                                                        <Run Text="默认："/>
                                                        <Run Text="{Binding DefaultText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- 右：按 ParamKind 切换编辑控件 -->
                                                <ContentControl Grid.Column="1" Content="{Binding}"
                                                                VerticalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource TextEditor}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Meta.Kind}"
                                                                             Value="{x:Static models:ParamKind.Number}">
                                                                    <Setter Property="ContentTemplate"
                                                                            Value="{StaticResource NumberEditor}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Meta.Kind}"
                                                                             Value="{x:Static models:ParamKind.Bool}">
                                                                    <Setter Property="ContentTemplate"
                                                                            Value="{StaticResource BoolEditor}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Meta.Kind}"
                                                                             Value="{x:Static models:ParamKind.Enum}">
                                                                    <Setter Property="ContentTemplate"
                                                                            Value="{StaticResource EnumEditor}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Meta.Kind}"
                                                                             Value="{x:Static models:ParamKind.Complex}">
                                                                    <Setter Property="ContentTemplate"
                                                                            Value="{StaticResource ComplexEditor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部操作栏：状态 / 文件路径 + 恢复默认 / 重新加载 / 保存 -->
        <Border Grid.Row="2" Style="{DynamicResource MoeCardStyle}" Padding="20,14" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SettingsPath}" Style="{DynamicResource MutedTextStyle}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↩ 恢复默认" Style="{DynamicResource MoeButtonStyle}"
                            Command="{Binding ResetToDefaultCommand}"/>
                    <Button Content="🔄 重新加载" Style="{DynamicResource MoeButtonStyle}"
                            Margin="10,0,0,0" Command="{Binding ReloadCommand}"/>
                    <Button Content="💾 保存" Style="{DynamicResource PrimaryButtonStyle}"
                            Margin="10,0,0,0" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
