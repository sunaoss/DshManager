<UserControl x:Class="DshManager.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 类型徽章：半透明鲸鱼蓝圆角块 -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#334FC3F7"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- 危险操作按钮：玫红底醒目（卸载不可恢复） -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MoeButtonStyle}">
            <Setter Property="Background" Value="#FFFF5277"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 清单行容器：浅色圆角行 -->
        <Style x:Key="FileRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ============ 安装位置卡片：多来源探测结果 ============ -->
                <Border Style="{DynamicResource MoeCardStyle}" Padding="22,20" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- 卡片头：标题 + 刷新（与下方文件清单共用同一刷新入口） -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍" FontSize="19" VerticalAlignment="Center"/>
                                <TextBlock Text="dsh 安装位置" Style="{DynamicResource SectionTitleStyle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="自动搜索 npm 全局 / dsh profiles / npx 缓存 / ai-manager / PATH / 工作目录"
                                           Style="{DynamicResource MutedTextStyle}" Margin="14,4,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="🔄 刷新" Style="{DynamicResource MoeButtonStyle}" Padding="10,6"
                                    HorizontalAlignment="Right" Command="{Binding RefreshCommand}"/>
                        </Grid>

                        <!-- 安装位置清单：一条一个来源（来源徽章 / 版本 / 体积 / 可用性 / 路径） -->
                        <ItemsControl ItemsSource="{Binding Installations}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource FileRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 来源徽章（如「npx 缓存」「npm 全局」） -->
                                            <Border Style="{DynamicResource BadgeStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceText}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>

                                            <!-- 版本 / 体积 / 可用性 + 路径（超长截断，Tooltip 显示全文） -->
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VersionText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding SizeText}" Style="{DynamicResource MutedTextStyle}"
                                                               Margin="10,0,0,0"/>
                                                    <!-- 可用=绿，不可用=粉 -->
                                                    <TextBlock Text="{Binding UsableText}" FontSize="11" FontWeight="SemiBold"
                                                               Margin="10,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PinkAccentBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUsable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OkGreenBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PackageDir}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageDir}"/>
                                                <!-- 符号链接 / Junction 标注：profiles 下的包常是指向 npx 缓存的链接，
                                                     标注「快捷方式 → 目标」避免用户把同一物理位置的两个入口误认为重复安装；
                                                     LinkText 为空（非链接）时整行隐藏 -->
                                                <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LinkTarget}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <!-- LinkText 是只读派生属性，Run.Text 必须显式 OneWay（默认 TwoWay 会抛异常） -->
                                                    <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 打开位置 / 复制路径 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="打开位置" Padding="10,6"
                                                        Style="{DynamicResource MoeButtonStyle}"
                                                        Command="{Binding DataContext.OpenInstallationCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="复制路径" Padding="10,6" Margin="8,0,0,0"
                                                        Style="{DynamicResource MoeButtonStyle}"
                                                        Command="{Binding DataContext.CopyInstallationPathCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空状态：一个安装位置都没找到时显示 -->
                        <TextBlock Text="🐳 未找到 dsh 安装位置，可在「设置」页手动指定后点「刷新」"
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Installations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ 文件清单卡片 ============ -->
                <Border Style="{DynamicResource MoeCardStyle}" Padding="22,20" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- 卡片头：标题 + 刷新 / 打开数据目录 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="19" VerticalAlignment="Center"/>
                                <TextBlock Text="dsh 相关文件" Style="{DynamicResource SectionTitleStyle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="自动扫描发现的位置与配置文件" Style="{DynamicResource MutedTextStyle}"
                                           Margin="14,4,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="🔄 刷新" Style="{DynamicResource MoeButtonStyle}" Padding="10,6"
                                        Command="{Binding RefreshCommand}"/>
                                <Button Content="📂 打开数据目录" Style="{DynamicResource MoeButtonStyle}" Padding="10,6"
                                        Margin="8,0,0,0" Command="{Binding OpenDataDirCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 文件清单 -->
                        <ItemsControl ItemsSource="{Binding Locations}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource FileRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 类型徽章 -->
                                            <Border Style="{DynamicResource BadgeStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>

                                            <!-- 路径 + 描述 -->
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Path}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Description}" Style="{DynamicResource MutedTextStyle}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- 打开位置 -->
                                            <Button Grid.Column="2" Content="打开位置" Padding="10,6" VerticalAlignment="Center"
                                                    Style="{DynamicResource MoeButtonStyle}"
                                                    Command="{Binding DataContext.OpenLocationCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空状态提示：清单为空时显示 -->
                        <TextBlock Text="🐳 未发现 dsh 相关文件，点击右上角「刷新」再试试"
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Locations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ 一键卸载卡片 ============ -->
                <Border Style="{DynamicResource MoeCardStyle}" Padding="22,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="19" VerticalAlignment="Center"/>
                            <TextBlock Text="一键卸载 dsh" Style="{DynamicResource SectionTitleStyle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="停止进程并删除启动器与数据目录 · 不可恢复"
                                       Style="{DynamicResource MutedTextStyle}" Margin="14,4,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="🗑️ 一键卸载 dsh" MinWidth="170" Padding="18,10"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    Command="{Binding UninstallCommand}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="18,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
