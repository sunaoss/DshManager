<UserControl x:Class="DshManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 布尔 → 可见性：用于修复按钮 / 修复输出区的显隐 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="26,20,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶部大标题区 -->
            <RowDefinition Height="Auto"/>   <!-- 第一行三张卡片 -->
            <RowDefinition Height="Auto"/>   <!-- 环境检测卡片 -->
            <RowDefinition Height="Auto"/>   <!-- dsh 进程列表 -->
            <RowDefinition Height="*"/>      <!-- 日志卡片（占满剩余高度） -->
        </Grid.RowDefinitions>

        <!-- ============ 顶部大标题区 ============ -->
        <StackPanel Margin="2,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐳" FontSize="30" VerticalAlignment="Center"/>
                <TextBlock Text="深海控制中心" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="DeepSeek Harness · 启动 / 停止 / 监控 一手掌握"
                       Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ============ 第一行：三张卡片 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 卡 a：安装状态 -->
            <Border Grid.Column="0" Style="{DynamicResource MoeCardStyle}" Padding="18,16" Margin="0,0,8,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text="安装状态" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 已安装 v版本（绿） / 未安装（粉），由 IsInstalled 驱动变色 -->
                    <TextBlock Text="{Binding VersionText}" FontSize="24" FontWeight="Bold" Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OkGreenBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource PinkAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 数据目录 / 启动方式（超长自动换行） -->
                    <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0" TextWrapping="Wrap">
                        <Run Text="数据目录："/><Run Text="{Binding Info.DataDir}"/>
                    </TextBlock>
                    <!-- 启动方式：显示实际会执行的命令（LaunchCommand），而非可能悬空的启动器 shim。
                         原「启动器」展示的 Info.LauncherPath 只是按候选顺序找到的第一个启动文件，
                         本机实测它可能是指向不存在路径的坏 shim，点启动时并不使用，展示出来会误导用户。 -->
                    <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"
                               ToolTip="{Binding Info.LaunchCommand}">
                        <Run Text="启动方式："/><Run Text="{Binding LaunchCommandText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 推荐安装位置：版本（上方大字）/ 来源 / 包目录，可一键在资源管理器中打开 -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <!-- 找到推荐安装位置时才显示 -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendedInstallation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="推荐安装位置" Style="{DynamicResource MutedTextStyle}"/>
                        <!-- Run.Text 默认是 TwoWay 绑定，指向只读属性必须显式声明 Mode=OneWay -->
                        <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap">
                            <Run Text="来源："/><Run Text="{Binding RecommendedInstallation.SourceText, Mode=OneWay}"/>
                            <Run Text="  ·  "/><Run Text="{Binding RecommendedInstallation.UsableText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   ToolTip="{Binding RecommendedInstallation.PackageDir, Mode=OneWay}">
                            <Run Text="位置："/><Run Text="{Binding RecommendedInstallation.PackageDir, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Content="📂 打开位置" Style="{DynamicResource MoeButtonStyle}" Padding="10,6"
                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                Command="{Binding OpenInstallLocationCommand}"/>
                    </StackPanel>

                    <!-- 未找到安装位置时的提示（探测完成后才显示，避免"检测中"时闪烁） -->
                    <TextBlock Text="未找到 dsh 安装位置，可在「设置」页「dsh 安装位置」处手动指定"
                               Margin="0,14,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource PinkAccentBrush}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding InstallScanDone}" Value="True"/>
                                            <Condition Binding="{Binding RecommendedInstallation}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 卡 b：进程状态 -->
            <Border Grid.Column="1" Style="{DynamicResource MoeCardStyle}" Padding="18,16" Margin="8,0,8,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔮" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text="进程状态" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 状态灯 + 状态文本，颜色随 ProcessStatusBrush 联动。
                         用 DockPanel 而非横向 StackPanel：外部实例的状态文案较长
                         （"运行中（外部启动 / 非面板启动）"），需要按剩余宽度自动换行，避免被卡片裁掉。 -->
                    <DockPanel Margin="0,14,0,0">
                        <Ellipse DockPanel.Dock="Left" Style="{DynamicResource StatusLightStyle}"
                                 Fill="{Binding ProcessStatusBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProcessStatusText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding ProcessStatusBrush}" TextWrapping="Wrap"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0" TextWrapping="Wrap">
                        <Run Text="Web 地址："/><Run Text="{Binding WebUrlText}"/>
                    </TextBlock>
                    <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0">
                        <Run Text="端口："/><Run Text="{Binding PortText}"/>
                    </TextBlock>

                    <!-- 启动进度：替代"一直显示启动中"的干等，进度到 95% 封顶（最后 5% 留给端口就绪） -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Minimum="0" Maximum="100" Height="8" BorderThickness="0"
                                     Background="{DynamicResource TrackBgBrush}"
                                     Foreground="{DynamicResource WhaleBlueBrush}"
                                     Value="{Binding StartProgressPercent, Mode=OneWay}"/>
                        <TextBlock Text="{Binding StartPhaseText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{DynamicResource MutedTextStyle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- 外部/残留实例说明：明确告诉用户"可以直接用「打开网页」，也可以用「终止该实例」清掉" -->
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="{Binding IsExternalInstance, Converter={StaticResource BoolToVis}}"
                               Text="这个 dsh 不是面板启动的（可能是手动/脚本启动或上次残留）。你可以直接点「打开网页」使用它；也可以点「终止该实例」把它结束，然后用「启动」由面板重新拉起。"/>

                    <!-- 外部实例的进程位置（PID + 命令行）：满足"我可以通过进程检测位置删掉"的诉求 -->
                    <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="{Binding HasExternalInstanceLocation, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding ExternalInstanceLocationFull, Mode=OneWay}">
                        <Run Text="进程位置："/><Run Text="{Binding ExternalInstanceLocation, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 卡 c：快捷操作 -->
            <Border Grid.Column="2" Style="{DynamicResource MoeCardStyle}" Padding="18,16" Margin="8,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text="快捷操作" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 控制按钮：IsEnabled 由命令的 CanExecute 自动驱动；
                         ToolTip 说明"为什么当前可点/不可点"，避免用户误以为按钮坏了（点了没反应）。
                         ToolTipService.ShowOnDisabled：按钮被禁用时也显示 ToolTip，让用户能看到禁用原因。 -->
                    <WrapPanel Margin="0,12,0,0">
                        <!-- 「启动」按钮随状态改文案与行为（同一按钮，不新增）：未运行=启动、运行中=打开网页、
                             运行中（外部）=使用已运行的实例；文案绑定只读属性 StartButtonText，必须显式 Mode=OneWay。 -->
                        <Button Content="{Binding StartButtonText, Mode=OneWay}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding StartCommand}" Margin="0,0,8,8"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding StartButtonToolTip, Mode=OneWay}"/>
                        <Button Content="⏹ 停止" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding StopCommand}" Margin="0,0,8,8"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding StopButtonToolTip, Mode=OneWay}"/>
                        <Button Content="🔄 重启" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding RestartCommand}" Margin="0,0,8,8"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding RestartButtonToolTip, Mode=OneWay}"/>
                        <Button Content="🌐 打开网页" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding OpenWebCommand}" Margin="0,0,8,8"
                                ToolTip="{Binding OpenWebButtonToolTip, Mode=OneWay}"/>
                        <!-- 仅在检测到外部/残留实例时出现：显式确认后结束该实例，让「启动」恢复可用 -->
                        <Button Content="⛔ 终止该实例" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding TerminateExternalCommand}" Margin="0,0,8,8"
                                Background="{DynamicResource PinkAccentBrush}" Foreground="#FF2A0B18"
                                FontWeight="SemiBold"
                                Visibility="{Binding IsExternalInstance, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding TerminateExternalButtonToolTip, Mode=OneWay}"/>
                        <Button Content="📦 安装" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding InstallCommand}" Margin="0,0,8,8"/>
                        <Button Content="⬆ 更新" Style="{DynamicResource MoeButtonStyle}"
                                Command="{Binding UpdateCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <!-- 状态提示消息 -->
                    <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource MutedTextStyle}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 环境检测卡片 ============ -->
        <Border Grid.Row="2" Style="{DynamicResource MoeCardStyle}" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <!-- 卡片头：标题 + 检测摘要 + 重新检测按钮 -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding EnvSummaryText, Mode=OneWay}"
                                   Style="{DynamicResource MutedTextStyle}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- 一键安装全部缺失项：存在 1 个以上可执行修复项时可用（可执行性由 VM 计算） -->
                        <Button Content="⚡ 一键安装全部缺失项" Style="{DynamicResource MoeButtonStyle}"
                                Background="{DynamicResource WhaleBlueBrush}" Foreground="#FF06242F"
                                FontWeight="SemiBold" Margin="0,0,8,0"
                                IsEnabled="{Binding CanInstallAllMissing, Mode=OneWay}"
                                Command="{Binding InstallAllMissingCommand}"/>
                        <Button Content="🔄 重新检测" Style="{DynamicResource MoeButtonStyle}"
                                Background="#22FFFFFF"
                                Command="{Binding RefreshEnvironmentCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🩺" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text="环境检测" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="启动 dsh 前的自检：Node / npm / dsh / 依赖 / 端口 / 配置"
                                   Style="{DynamicResource MutedTextStyle}" Margin="10,3,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- 检测项列表：数量固定为 6 项，超高时滚动，避免把下方日志区挤出屏幕 -->
                <ScrollViewer MaxHeight="230" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EnvironmentChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#220A1620" BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 状态图标：✅ / ⚠️ / ❌ -->
                                        <TextBlock Grid.Column="0" Text="{Binding Icon, Mode=OneWay}"
                                                   FontSize="13" VerticalAlignment="Top" Margin="0,1,8,0"/>

                                        <!-- 名称 + 详情 + 中文建议 -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush, Mode=OneWay}"/>
                                            <TextBlock Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap"
                                                       FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Hint, Mode=OneWay}" TextWrapping="Wrap"
                                                       Style="{DynamicResource MutedTextStyle}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- 操作区：修复按钮 + 官网链接按钮 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- 修复按钮：文案取 FixLabel；命令型用主色，链接型用次级按钮 -->
                                            <Button Content="{Binding FixLabel, Mode=OneWay}"
                                                    Padding="12,6"
                                                    Visibility="{Binding HasFix, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RunEnvFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MoeButtonStyle}">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Style.Triggers>
                                                            <!-- 执行命令型（一键安装 / 修复依赖）用鲸鱼蓝主色强调 -->
                                                            <DataTrigger Binding="{Binding IsCommandFix}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WhaleBlueBrush}"/>
                                                                <Setter Property="Foreground" Value="#FF06242F"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- 官网链接按钮：LinkUrl 为空 / 非法时不显示；弱化底色，不抢修复主按钮视觉 -->
                                            <Button Content="{Binding LinkLabel, Mode=OneWay}"
                                                    Padding="10,6" Margin="8,0,0,0"
                                                    Visibility="{Binding HasLink, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenEnvLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MoeButtonStyle}">
                                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WhaleBlueLightBrush}"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 修复命令执行进度 / 输出：仅在执行过修复后显示 -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasEnvFixOutput, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EnvFixStatusText, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource WhaleBlueLightBrush}"/>
                    <Border Background="#330A1620" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,6,0,0">
                        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding EnvFixOutputText, Mode=OneWay}" FontFamily="Consolas"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 第二行：dsh 进程列表 ============ -->
        <Border Grid.Row="3" Style="{DynamicResource MoeCardStyle}" Padding="18,16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 卡片头：标题 + 刷新说明 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧭" FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Text="进程列表" Style="{DynamicResource SectionTitleStyle}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="每 2 秒自动刷新（主服务 / 子进程）"
                               Style="{DynamicResource MutedTextStyle}" Margin="10,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 表格区：表头 + 分隔线 + 行列表 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 表头：列宽需与下方行模板保持一致 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PID" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="角色" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="内存" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="CPU" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="启动时间" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Margin="0,8,0,0"
                               Fill="{DynamicResource BorderSoftBrush}"/>

                    <!-- 空态占位：没有 dsh 进程时显示 -->
                    <TextBlock Grid.Row="2" Text="🐳 未检测到 dsh 进程"
                               HorizontalAlignment="Center" Margin="0,16,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInstances}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 进程行：数量少且整体替换，用 ItemsControl 即可（限制高度避免挤压日志区） -->
                    <ScrollViewer Grid.Row="2" MaxHeight="150" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Pid}" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <!-- 主服务用鲸鱼蓝加粗，子进程用次级文字色 -->
                                        <TextBlock Grid.Column="1" Text="{Binding RoleText}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WhaleBlueBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding MemText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StartTimeText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 第三行：实时日志卡片 ============ -->
        <Border Grid.Row="4" Style="{DynamicResource MoeCardStyle}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 卡片头：标题 + 清空按钮 -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🐚" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text="实时日志" Style="{DynamicResource SectionTitleStyle}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="🧹 清空" Style="{DynamicResource MoeButtonStyle}"
                            Command="{Binding ClearLogsCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 日志内容区：追加新行时由 code-behind 自动滚动到底部 -->
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="NoWrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
